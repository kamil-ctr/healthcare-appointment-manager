{
  "name": "healthcare-appointment-manager-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the Healthcare Appointment & Follow-up Manager",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/index.js",
