# ---------------------------------------------------------------
# Copy to server/.env and fill in.  NEVER commit the real .env.
# ---------------------------------------------------------------

# --- core ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- database (Neon / Supabase / local Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/healthcare
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- auth ---
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_SECONDS=43200

# --- admin seed (npm run seed:admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- booking rules ---
SLOT_HOLD_MINUTES=10

# --- LLM (day 5) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_MS=15000

# --- email / SMTP (day 6) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clinic <no-reply@example.com>

# --- Google Calendar OAuth 2.0 (day 7) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# --- background jobs (day 6+) ---
JOB_INTERVAL_MS=60000
JOB_TRIGGER_SECRET=replace-with-a-random-string
